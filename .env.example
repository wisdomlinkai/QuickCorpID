# QuickCorpID Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ===========================================
# AWS Configuration (Required)
# ===========================================
# AWS Region (default: ap-east-1 for Hong Kong)
VITE_AWS_REGION=ap-east-1

# ===========================================
# Amazon Cognito Configuration (Required)
# ===========================================
# Create a User Pool in AWS Cognito
# https://console.aws.amazon.com/cognito/users

# Cognito User Pool ID
VITE_COGNITO_USER_POOL_ID=ap-east-1_xxxxxxxx

# Cognito App Client ID
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Identity Pool ID (optional, for S3 access)
VITE_COGNITO_IDENTITY_POOL_ID=ap-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===========================================
# Amazon S3 Configuration (Required for documents)
# ===========================================
# S3 bucket for document uploads
VITE_S3_BUCKET=your-bucket-name

# ===========================================
# Optional: API Gateway Endpoint
# ===========================================
# If you deploy a REST API for backend operations
# VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-east-1.amazonaws.com/prod

# ===========================================
# Optional: Feature Flags
# ===========================================
# VITE_ENABLE_COBRANDING=true
# VITE_DEFAULT_BRAND=corpid
